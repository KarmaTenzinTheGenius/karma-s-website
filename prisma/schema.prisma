generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  phone        String?   @unique
  passwordHash String?
  role         UserRole  @default(CUSTOMER)
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  cart         Cart?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String   @default("Home")
  name       String   @default("")
  phone      String   @default("")
  line1      String   @default("")
  line2      String?
  city       String   @default("")
  state      String   @default("")
  postalCode String   @default("")
  isDefault  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
  createdAt  DateTime @default(now())
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Product {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  sku         String        @unique
  name        String
  description String        @db.Text
  category    String
  categoryId  String?
  categoryRef Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory String?
  brand       String?
  material    String?
  gender      String?
  tags        String[]      @default([])
  image       String
  price       Decimal       @db.Decimal(10, 2)
  mrp         Decimal?      @db.Decimal(10, 2)
  discount    Float         @default(0)
  stock       Int           @default(0)
  isActive    Boolean       @default(true)
  status      ProductStatus @default(ACTIVE)
  featured    Boolean       @default(false)
  images      ProductImage[]
  variants    ProductVariant[]
  movements   StockMovement[]
  orderItems  OrderItem[]
  reviews     Review[]
  cartItems   CartItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category, isActive])
  @@index([categoryId])
  @@index([status, isActive])
  @@index([stock])
  @@index([featured, status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model ProductImageAsset {
  id          String   @id @default(cuid())
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}

model ProductVariant {
  id        String      @id @default(cuid())
  productId Int
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  colorName String?
  colorHex  String?
  sku       String?     @unique
  stock     Int         @default(0)
  isActive  Boolean     @default(true)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  movements StockMovement[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([productId, isActive])
  @@unique([productId, size, colorName])
}

model StockMovement {
  id        String          @id @default(cuid())
  productId Int?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  change    Int
  reason    String
  orderId   String?
  createdAt DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
}

model StoreSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId Int
  variantId String?
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  amountOff     Decimal? @db.Decimal(10, 2)
  percentOff    Int?
  minimumAmount Decimal  @default(0) @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int      @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  userId           String?
  addressId        String?
  email            String
  status           OrderStatus @default(PENDING)
  paymentMethod    String
  paymentStatus    String      @default("PENDING")
  subtotal         Decimal     @db.Decimal(10, 2)
  discount         Decimal     @default(0) @db.Decimal(10, 2)
  shipping         Decimal     @default(0) @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  gstInvoiceNumber String?     @unique
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  address          Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId Int?
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String
  sku       String
  size      String?
  colorName String?
  quantity  Int
  unitPrice Decimal         @db.Decimal(10, 2)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Review {
  id        String   @id @default(cuid())
  productId Int
  userId    String?
  name      String
  rating    Int
  comment   String   @db.Text
  isVisible Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([productId, isVisible, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  orderId   String?
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  image     String
  href      String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
}
